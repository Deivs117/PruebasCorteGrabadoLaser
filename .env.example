# Plantilla de variables de entorno (issue #1/#23). Copiar a .env y completar
# con los valores reales -- .env NUNCA se versiona (ver .gitignore).
#
# Hay dos proyectos de Supabase (decisión de #1): uno para dev/preview, otro
# para producción. En local se usa el de dev/preview.

# --- packages/laser_toolkit (lo lee laser_toolkit.db.base.crear_engine) ---
# Cadena de conexión Postgres del proyecto Supabase de dev/preview.
# Formato: postgresql+psycopg://postgres:<password>@<host>:5432/postgres
DATABASE_URL=

# --- apps/web (Next.js) ---
# URL y llave pública (anon) del mismo proyecto Supabase de dev/preview --
# se usan solo para Auth en el cliente, nunca para escribir datos directo
# (esa decisión ya está tomada: todas las escrituras pasan por Python, ver #1).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
